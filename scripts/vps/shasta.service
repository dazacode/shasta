# /etc/systemd/system/shasta.service (source: scripts/vps/shasta.service)
# Runs the shasta:current image (built and tagged by shasta-ctl). systemd still owns the lifecycle, so shasta-ctl,
# the health watchdog, journald and the Cloudflare tunnel / Caddy (127.0.0.1:8080 / :8081) work as before.
[Unit]
Description=Shasta backend (static files, Store API, Wisp relay) in Docker
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
ExecStartPre=/usr/local/sbin/shasta-docker-firewall
ExecStartPre=-/usr/bin/docker rm -f shasta
# Same limits as the old systemd sandbox: the store user (shasta-app 999:989) owns /var/lib/shasta/data, read-only
# image, no capabilities, no privilege gain, published on loopback only.
ExecStart=/usr/bin/docker run --rm --name shasta --init \
	--network shasta -p 127.0.0.1:8080:8080 -p 127.0.0.1:8081:8081 \
	--env-file /etc/shasta/shasta.env -e HOST=0.0.0.0 -e STORE_DIR=/data -e STATIC_DIR=/app/dist \
	-v /var/lib/shasta/data:/data \
	--user 999:989 --read-only --tmpfs /tmp:rw,nosuid,nodev,size=512m \
	--cap-drop ALL --security-opt no-new-privileges \
	--pids-limit 4096 --memory 16g --memory-reservation 12g --ulimit nofile=65536:65536 \
	--log-opt max-size=20m --log-opt max-file=3 \
	shasta:current
ExecStop=/usr/bin/docker stop -t 15 shasta
Restart=always
RestartSec=2
TimeoutStartSec=120
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
