# Copy to .env for local use. NEVER commit real values (.env is gitignored).
# Server (server/server.mjs, read at start):
PORT=8080
# Set to 1 only behind a trusted reverse proxy / tunnel (real client IPs for rate limits and Wisp).
TRUST_PROXY=0
# Where uploaded Store apps are served, one hostname each. {key} is required; needs wildcard DNS + TLS.
# Unset = <key>.apps.localhost:<port>, which only works on the machine running the server.
# CONTENT_ORIGIN=https://{key}.apps.example.com
# STORE_DIR=./data
# Fix the owner setup code instead of printing a random one at start.
# OWNER_SETUP_CODE=
# "Apply to publish" (Store -> Publish): 0 closes the form. Past MAX_PENDING unanswered ones, new ones are refused.
# STORE_APPLICATIONS=1
# STORE_APPLICATIONS_MAX_PENDING=200
# 0 turns cross-origin isolation off (threaded wasm games stop working).
# CROSS_ORIGIN_ISOLATION=1
# WISP_STREAMS_TOTAL=500
# WISP_PORT_BLACKLIST=25,465,587

# Build-time (baked into shasta/dist, so set when running `bun run build`):
# The downloadable app (a signed .swbn) and the admin update manifest. Static files: any host works,
# no backend. `bun run build:iwa` with IWA_BASE_URL prints the two URLs to put here.
# VITE_APP_BUNDLE_URL=https://github.com/dazacode/shasta-releases/releases/download/app-latest/shasta.swbn
# VITE_APP_UPDATE_MANIFEST_URL=https://github.com/dazacode/shasta-releases/releases/download/app-latest/update.json
# Wisp endpoint when the frontend is NOT served by the same server (static hosting).
# VITE_WISP_URL=wss://api.example.com/wisp/
# Where visitors can get the source of the version they are using (AGPL section 13; Settings -> About).
# The public snapshot is `bun run publish:source`; every hosted build must set this.
VITE_SOURCE_URL=https://github.com/dazacode/shasta
# Keeps F12 and friends in a production build. Leave unset for public builds.
# VITE_ALLOW_DEVTOOLS=1

# bun run deploy <vercel|cloudflare>:
# SHASTA_BACKEND_URL=https://api.example.com
# SHASTA_PROJECT=shasta
# VERCEL_SCOPE=dazaseals-projects
# CLOUDFLARE_API_TOKEN=   (or run `bunx wrangler login`)
# CLOUDFLARE_ACCOUNT_ID=8552691187cf71a442505a28a8e80fa0

# Ko-fi membership verification (optional). Webhook URL: https://<your-host>/api/kofi/webhook
# Ko-fi -> Settings -> API -> Webhooks -> Verification token. Unset = the webhook route does not exist (404).
KOFI_VERIFICATION_TOKEN=
# Only payments for this membership tier grant a Supporter pass (case-insensitive).
KOFI_TIER_NAME=Shasta Supporter

# Share links for Store pages (https://<site>/?app=<slug>) use the page's own origin. The installed app has none
# (isolated-app://), so it needs the public https address of the web version here; without it, it hides Share.
# VITE_SHARE_ORIGIN=https://shasta.example.com

# /check (Discord + GET /api/filters/check): school web filters. Most vendors need nothing.
# GoGuardian works out of the box: the adapter registers a live extension token with GoGuardian itself.
# To pin a fixed token instead, point GOGUARDIAN_TOKEN_URL at a hosted OpenSSL-encrypted blob (the old
# community "lol" file), or paste the blob as GOGUARDIAN_TOKEN. Both are optional overrides.
# GOGUARDIAN_TOKEN_URL=
# GOGUARDIAN_TOKEN=
# Cisco Umbrella's Investigate API key. Without it /check falls back to Cisco Talos, which needs no key.
# UMBRELLA_API_KEY=
# LanSchool (a Netsweeper appliance) and Lightspeed (their extension socket) host overrides.
# LANSCHOOL_URL=https://filter.wavenetcloud.netsweeper.com:3431
# LIGHTSPEED_IP=174.85.104.135
# LIGHTSPEED_CUSTOMER_ID=74-1082-F000
